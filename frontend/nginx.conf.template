# Cloudflare's ranges (https://www.cloudflare.com/ips/), so rate limits and logs see visitors, not Cloudflare.
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# Rate limits for the expensive calls only: starting a sequence (POST /api/sequences) and full probe
# measurements (/probe?mode=full). GETs, polling and images are unlimited. Requests from this host and the
# Docker network (prewarm, health checks) are exempt; visitors arrive with their real IP (Docker DNAT).
geo $limited {
    default 1;
    127.0.0.1/32 0;
    172.16.0.0/12 0;
}
map "$limited:$request_method" $seq_start_key {
    "1:POST" $binary_remote_addr;
    default "";
}
map "$limited:$arg_mode" $probe_full_key {
    "1:full" $binary_remote_addr;
    default "";
}
limit_req_zone $seq_start_key zone=seqstart:10m rate=12r/m;
limit_req_zone $probe_full_key zone=probefull:10m rate=4r/m;

server {
    listen 80;
    server_name ${PUBLIC_HOSTNAME};
    root /usr/share/nginx/html;
    limit_req_status 429;
    # the app shows `detail` of error responses: say what happened instead of an nginx HTML page
    error_page 429 = @ratelimited;
    location @ratelimited {
        default_type application/json;
        return 429 '{"detail":"Too many new fields or full measurements from your address; please wait a minute and try again."}';
    }

    location = /api/sequences {
        limit_req zone=seqstart burst=20 nodelay;
        proxy_pass http://api:8000/api/sequences;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }

    location ~ ^/api/sequences/[^/]+/probe$ {
        limit_req zone=probefull burst=4 nodelay;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }

    location /api/ {
        proxy_pass http://api:8000/api/;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }

    # hashed bundles never change; index.html must be revalidated so redeploys reach browsers
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
